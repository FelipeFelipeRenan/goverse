# Copie para .env (opcional: o padrão já funciona com `make up`).

# Porta pública da API. O frontend espera 80.
GOVERSE_PUBLIC_PORT=80
GOVERSE_POSTGRES_PASSWORD=goverse
# Origens do frontend aceitas (CORS e WebSocket), separadas por vírgula.
GOVERSE_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Login com Google (opcional). Redirect URI a cadastrar no console do Google:
#   http://localhost/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/oauth/google/callback
